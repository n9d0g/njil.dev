---
import Layout from '@layouts/Layout.astro'
import { PUBLIC_RECAPTCHA_SITE_KEY } from 'astro:env/client'
import { MAX_MESSAGE_LENGTH, MAX_NAME_LENGTH } from '@lib/contact'

const siteKey = PUBLIC_RECAPTCHA_SITE_KEY
const inputClass =
	'rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100 placeholder-slate-500 transition focus:border-slate-500 focus:outline-none'
---

<Layout title="Nathan Lardizabal | Contact">
	<h1 class="mb-8 text-2xl font-semibold">contact me</h1>
	<!-- TODO(nathan): write the "what i'm open to" blurb -->
	<p class="text-sm font-light text-slate-300">
		[placeholder] what i'm open to hearing about goes here.
	</p>
	<p class="mt-2 text-sm font-light text-slate-300">
		you can also find me on
		<a
			href="https://www.linkedin.com/in/n9d0g"
			target="_blank"
			rel="noopener noreferrer"
			class="text-slate-100 underline transition hover:text-slate-50">linkedin</a
		>
		or read my <a
			href="/resume.pdf"
			class="text-slate-100 underline transition hover:text-slate-50">resume</a
		>.
	</p>
	<hr class="my-4 border-slate-700" />
	<form id="contact-form" class="flex flex-col gap-3">
		<label class="flex flex-col gap-1 text-sm text-slate-400">
			name <span class="text-xs text-slate-600">(optional)</span>
			<input
				type="text"
				name="name"
				maxlength={MAX_NAME_LENGTH}
				autocomplete="name"
				class={inputClass}
			/>
		</label>
		<label class="flex flex-col gap-1 text-sm text-slate-400">
			email
			<input
				type="email"
				name="email"
				required
				autocomplete="email"
				placeholder="your@email.com"
				class={inputClass}
			/>
		</label>
		<label class="flex flex-col gap-1 text-sm text-slate-400">
			message
			<textarea
				name="message"
				required
				rows="6"
				maxlength={MAX_MESSAGE_LENGTH}
				class={inputClass}></textarea>
		</label>
		<button
			type="submit"
			class="cursor-pointer self-start rounded-lg bg-slate-700 px-4 py-2 text-sm text-slate-100 transition hover:bg-slate-600 disabled:cursor-not-allowed disabled:opacity-50"
		>
			send
		</button>
		<p id="contact-form-message" class="text-xs" aria-live="polite"></p>
		<p class="text-[10px] text-slate-600">protected by reCAPTCHA</p>
	</form>
</Layout>

<script define:vars={{ siteKey }}>
	const form = document.getElementById('contact-form')
	const messageEl = document.getElementById('contact-form-message')
	const submitBtn = form.querySelector('button[type="submit"]')

	form.addEventListener('submit', async (e) => {
		e.preventDefault()

		const data = new FormData(form)

		submitBtn.disabled = true
		submitBtn.textContent = 'sending...'

		try {
			await new Promise((resolve) => grecaptcha.ready(resolve))
			const recaptchaToken = await grecaptcha.execute(siteKey, {
				action: 'contact',
			})

			const response = await fetch('/api/contact', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					name: data.get('name'),
					email: data.get('email'),
					message: data.get('message'),
					recaptchaToken,
				}),
			})

			const body = await response.json()

			if (response.ok) {
				messageEl.textContent = body.message || 'thanks for reaching out!'
				messageEl.className = 'text-xs text-green-400'
				form.reset()
			} else {
				messageEl.textContent =
					body.error || 'something went wrong, please try again.'
				messageEl.className = 'text-xs text-red-400'
			}
		} catch (error) {
			messageEl.textContent = 'something went wrong, please try again.'
			messageEl.className = 'text-xs text-red-400'
		} finally {
			submitBtn.disabled = false
			submitBtn.textContent = 'send'
		}
	})
</script>
