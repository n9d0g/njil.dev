---
import Layout from '@layouts/Layout.astro'
import Chip from '@components/general/Chip.astro'
import CodeBlock from '@components/blog/CodeBlock.astro'
import InlineImage from '@components/blog/InlineImage.astro'
import BentoGallery from '@components/blog/BentoGallery.astro'
import { PortableText } from 'astro-portabletext'
import { blog } from '@lib/blog/live'

// Rendered per request so a newly published Blog post is live without a deploy
const post = await blog.getBlogPost(Astro.params.blog ?? '')

if (!post) return Astro.rewrite('/404')
---

<Layout title={`Nathan Lardizabal | ${post.title}`} description={post.description}>
	<article class="prose dark:prose-invert">
		<h1 class="mb-2 text-2xl font-semibold lowercase">{post.title}</h1>
		<div class="flex gap-2">
			{post.tags.map((tag) => <Chip {tag} />)}
		</div>
		<p class="my-2 text-sm font-light text-gray-400 italic">
			by {post.author} | {post.displayDate}
		</p>
		<div class="my-8 font-light">
			<PortableText
				value={post.body}
				components={{
					type: {
						code: CodeBlock,
						image: InlineImage,
					},
				}}
			/>
		</div>
		{post.gallery.length > 0 && <BentoGallery images={post.gallery} />}
	</article>
</Layout>
