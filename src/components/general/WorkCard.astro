---
import { Icon } from 'astro-icon/components'
import type { Job } from '@lib/career'

interface Props {
	job: Job
}

const { position, company, location, period, description, tech } =
	Astro.props.job
---

<article
	class="flex flex-col justify-between rounded border border-gray-700 p-4 transition hover:border-gray-400"
>
	<div>
		<h2 class="text-base text-slate-100">
			{position}
		</h2>
		<h3 class="my-1 text-xs font-light text-gray-300">
			{company} | {location}
		</h3>
		<p class="my-1 text-xs font-light text-gray-400">
			{period}
		</p>
		<p class="my-2 text-sm font-light text-slate-300">
			{description}
		</p>
	</div>
	<div class="flex flex-col">
		<div class="mt-4 flex gap-3">
			{
				tech.map((techIcon) => (
					<Icon
						name={techIcon}
						class="h-7 w-auto rounded-lg grayscale transition hover:grayscale-0"
						aria-hidden="true"
					/>
				))
			}
		</div>
	</div>
</article>
