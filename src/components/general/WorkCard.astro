---
import { Icon } from 'astro-icon/components'
import type { Job } from '@lib/career'

interface Props {
	job: Job
}

const { slug, position, company, location, period, description, tech, logo } =
	Astro.props.job
---

<a
	href={`/work/${slug}`}
	class="group flex flex-col justify-between rounded border border-gray-700 p-4 transition hover:border-gray-400"
>
	<div>
		<div class="flex items-center gap-3">
			{
				logo && (
					<img src={logo} alt="" class="size-8 rounded object-contain" />
				)
			}
			<h2 class="text-base text-slate-100">
				{position}
			</h2>
		</div>
		<h3 class="my-1 text-xs font-light text-gray-300">
			{company} | {location}
		</h3>
		<p class="my-1 text-xs font-light text-gray-400">
			{period}
		</p>
		<p class="my-2 text-sm font-light text-slate-300">
			{description}
		</p>
	</div>
	<div class="flex flex-col">
		<div class="mt-4 flex gap-3">
			{
				tech.map(({ icon, name }) => (
					<Icon
						name={icon}
						title={name}
						class="h-7 w-auto rounded-lg grayscale transition group-hover:grayscale-0"
					/>
				))
			}
		</div>
		<p
			class="mt-4 flex items-center self-end text-xs text-gray-500 transition group-hover:text-gray-50"
		>
			read more <Icon name="mdi:chevron-right" class="h-4 w-auto" />
		</p>
	</div>
</a>
