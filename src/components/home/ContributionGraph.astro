---
import type { ContributionGraph } from '@lib/contributions'

interface Props {
	graph: ContributionGraph
}

const { graph } = Astro.props

// Tailwind slate-800 for empty days, then blue-900 → blue-300 by level
const LEVEL_CLASSES = [
	'bg-slate-800',
	'bg-blue-900',
	'bg-blue-700',
	'bg-blue-500',
	'bg-blue-300',
]

const label = (count: number, date: string) =>
	`${count} contribution${count === 1 ? '' : 's'} on ${new Date(
		`${date}T00:00:00Z`
	).toLocaleDateString('en-CA', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	})}`
---

<figure class="my-8">
	<div
		data-contribution-graph={JSON.stringify(graph)}
		class="group relative flex h-56 items-center justify-center overflow-hidden [perspective:600px] sm:h-72 md:left-1/2 md:h-[32rem] md:w-[min(64rem,calc(100vw-4rem))] md:-translate-x-1/2"
	>
		<!-- On desktop the graph bleeds past the content column, so the spinning
		     year has room to be big; on phones it stays within the margins -->
		<!-- Shown instead of the 3D skyline without WebGL or JS -->
		<div
			data-flat
			class="grid w-full grid-flow-col grid-rows-7 gap-[2px] p-4 group-data-[loading]:hidden"
			aria-hidden="true"
		>
			{
				graph.weeks.map((week, x) =>
					week.map((day) => (
						<span
							title={label(day.count, day.date)}
							class:list={['aspect-square rounded-[1px]', LEVEL_CLASSES[day.level]]}
							style={`grid-column: ${x + 1}; grid-row: ${new Date(`${day.date}T00:00:00Z`).getUTCDay() + 1}`}
						/>
					))
				)
			}
		</div>
		<!-- Shown while three.js loads, roughly where the skyline's plane will be -->
		<div
			data-skeleton
			class="hidden w-[87%] [aspect-ratio:53/7] md:w-2/3 rotate-x-[66deg] rounded-sm bg-slate-800 transition-opacity duration-500 group-data-[loading]:block motion-safe:animate-pulse motion-reduce:transition-none"
			aria-hidden="true"
		>
		</div>
		<p
			data-tooltip
			class="pointer-events-none absolute hidden rounded bg-slate-900/90 px-2 py-1 text-xs text-slate-100"
		>
		</p>
	</div>
	<figcaption
		class="mt-2 flex justify-between text-xs font-light text-gray-500"
	>
		<a
			href={graph.profileUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="transition hover:text-gray-50"
		>
			{graph.total.toLocaleString('en-CA')} contributions on GitHub in the last year
		</a>
		<span data-hint class="hidden">drag to spin</span>
	</figcaption>
</figure>

<!-- Swaps the flat grid for the skeleton before first paint, and again after
     each client-side navigation, which re-runs inline scripts -->
<script is:inline>
	;(() => {
		const root = document.querySelector('[data-contribution-graph]')
		try {
			if (root && document.createElement('canvas').getContext('webgl2'))
				root.dataset.loading = ''
		} catch {}
	})()
</script>

<script>
	import type { ContributionGraph } from '@lib/contributions'

	const hasWebGL = () => {
		try {
			return !!document.createElement('canvas').getContext('webgl2')
		} catch {
			return false
		}
	}

	// Runs on every page view, including client-side navigations back home
	document.addEventListener('astro:page-load', () => {
		const root = document.querySelector<HTMLElement>('[data-contribution-graph]')
		if (!root || !hasWebGL()) return

		const graph: ContributionGraph = JSON.parse(root.dataset.contributionGraph!)
		let dispose: (() => void) | undefined
		root.dataset.loading = ''

		// The graph sits near the top of the homepage, so start fetching three.js
		// straight away, but only build the scene once it's about to be seen
		const skyline = import('./skyline')
		// Fall back to the flat grid if three.js never arrives
		skyline.catch(() => {
			observer.disconnect()
			delete root.dataset.loading
		})
		const observer = new IntersectionObserver(
			async (entries) => {
				if (!entries.some((e) => e.isIntersecting)) return
				observer.disconnect()

				const { mountSkyline } = await skyline.catch(() => ({ mountSkyline: null }))
				if (!mountSkyline || !root.isConnected) return
				dispose = mountSkyline(root, graph, () => {
					root.querySelector('[data-flat]')?.remove()
					const skeleton = root.querySelector<HTMLElement>('[data-skeleton]')
					if (!skeleton) return
					if (matchMedia('(prefers-reduced-motion: reduce)').matches)
						return skeleton.remove()
					skeleton.addEventListener('transitionend', () => skeleton.remove(), {
						once: true,
					})
					// The pulse animates opacity, so stop it before fading out
					skeleton.classList.remove('motion-safe:animate-pulse')
					skeleton.classList.add('opacity-0')
				})
				document.querySelector('[data-hint]')?.classList.remove('hidden')
			},
			{ rootMargin: '200px' }
		)
		observer.observe(root)

		document.addEventListener(
			'astro:before-swap',
			() => {
				observer.disconnect()
				dispose?.()
			},
			{ once: true }
		)
	})
</script>
