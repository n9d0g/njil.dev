---
import NavbarItem from './NavbarItem.astro'
import CommandPalette from './CommandPalette.astro'
import { pages } from '@lib/command-palette'
---

<nav
	class="container mx-auto flex w-full max-w-2xl justify-start gap-3 py-10 font-light sm:gap-4"
>
	{pages.map((item) => <NavbarItem href={item.href} label={item.label} />)}
	<CommandPalette />
</nav>
