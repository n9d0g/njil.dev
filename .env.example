SANITY_API_KEY=
SANITY_PROJECT_ID=
SANITY_WEBHOOK_SECRET=
RESEND_API_KEY=
DISCORD_WEBHOOK_URL=
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# signs Newsletter unsubscribe links: openssl rand -hex 32
NEWSLETTER_SECRET=
# uploads Sentry source maps at build time (CI only): org auth token
SENTRY_AUTH_TOKEN=
# reads the homepage Contribution graph: fine-grained token, public repos, no permissions
GITHUB_TOKEN=

# Cloudflare (CI deploy secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Actions repository variables (Settings → Actions → Variables): PUBLIC_RECAPTCHA_SITE_KEY, SANITY_PROJECT_ID
# GitHub Actions repository secrets: SENTRY_AUTH_TOKEN
# Worker runtime secrets (wrangler secret put [--env dev]): SANITY_API_KEY, RESEND_API_KEY, RECAPTCHA_SECRET_KEY, SANITY_WEBHOOK_SECRET, NEWSLETTER_SECRET, GITHUB_TOKEN
# Dev deploy (CLOUDFLARE_ENV=dev at build): targets Worker njil-qa (dev.njil.dev). Production is njil-prod.

# Local dev: these values live in the 1Password Environment "njil.dev", mounted at .env
# (Developer → Environments → Destinations → Local .env file). Don't create .dev.vars:
# Wrangler and the Cloudflare adapter only fall back to .env when .dev.vars is absent.
# Adding a variable: add it here (name only), then in the 1Password Environment.
