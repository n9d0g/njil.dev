{
	"name": "njil.dev",
	"version": "2.4.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"clean:cache": "rm -rf node_modules .astro pnpm-lock.yaml",
		"fresh": "vp run clean:cache && vp install && vp run format",
		"fresh:start": "vp run fresh && vp run dev",
		"cms": "vp run --filter cms dev",
		"cms:build": "vp run --filter cms build",
		"cms:deploy": "vp run --filter cms deploy",
		"typegen": "vp run --filter cms typegen",
		"prepare": "vp config",
		"lint": "vp lint",
		"check": "vp check",
		"check:fix": "vp check --fix"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.3",
		"@astrojs/react": "^6.0.2",
		"@astrojs/ts-plugin": "^1.10.10",
		"@iconify-json/logos": "^1.2.12",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.93",
		"@iconify-json/vscode-icons": "^1.2.72",
		"@portabletext/types": "^4.0.2",
		"@sanity/astro": "^3.5.0",
		"@sanity/client": "^7.26.2",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.5",
		"astro-icon": "^1.1.5",
		"astro-portabletext": "^0.13.0",
		"groq": "^3.88.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-email": "^6.9.2",
		"resend": "^6.20.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.2.0",
		"typescript": "^6.0.3",
		"vite-plus": "catalog:",
		"wrangler": "^4.147.0"
	},
	"packageManager": "pnpm@12.14.0"
}
