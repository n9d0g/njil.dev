{
	"name": "njil.dev",
	"version": "2.8.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"clean:cache": "rm -rf node_modules .astro pnpm-lock.yaml",
		"fresh": "vp run clean:cache && vp install && vp run format",
		"fresh:start": "vp run fresh && vp run dev",
		"cms": "vp run --filter cms dev",
		"cms:build": "vp run --filter cms build",
		"cms:deploy": "vp run --filter cms deploy",
		"typegen": "vp run --filter cms typegen",
		"prepare": "vp config && astro sync",
		"lint": "vp lint",
		"check": "vp check",
		"check:fix": "vp check --fix",
		"test": "vp test run"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.3",
		"@astrojs/react": "^7.1.2",
		"@astrojs/ts-plugin": "^1.10.12",
		"@iconify-json/logos": "^1.2.18",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.101",
		"@iconify-json/vscode-icons": "^1.2.95",
		"@portabletext/types": "^4.0.2",
		"@sanity/astro": "^3.6.0",
		"@sanity/client": "^8.14.1",
		"@sanity/webhook": "^4.0.4",
		"@sentry/astro": "^11.10.0",
		"@sentry/cloudflare": "^11.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.4",
		"astro-icon": "^1.2.0",
		"astro-portabletext": "^1.0.1",
		"groq": "^6.21.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-email": "^6.11.6",
		"resend": "^6.37.0",
		"tailwindcss": "^4.3.3",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/three": "^0.187.0",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@12.16.1"
}
